[Unit]
Description=Montara V2 exclusive outbound VPC connector
Requires=montara-pilot-acl.service
After=network-online.target montara-pilot-acl.service
BindsTo=montara-pilot-acl.service
[Service]
Type=exec
User=montara-pilot-ingress
Group=montara-pilot-ingress
Environment=HOME=/nonexistent
ExecStart=/opt/montara-pilot/ingress/cloudflared tunnel --no-autoupdate --protocol quic --metrics 127.0.0.1:20246 --loglevel error run --token-file /etc/montara-pilot-ingress/token
Restart=no
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/var/lib/montara-pilot /etc/montara-pilot -/etc/montara-pilot-enrol
MemoryMax=512M
TasksMax=128
StandardOutput=null
StandardError=null
UMask=0077
