[Unit]
Description=Montara CORE V2 DEVELOPMENT one-shot worker
[Service]
Type=exec
User=montara-pilot
Group=montara-pilot
WorkingDirectory=/var/lib/montara-pilot
Environment=HOME=/var/lib/montara-pilot/runtime-home
Environment=PATH=/opt/montara-pilot/current/media-tools:/usr/bin:/bin
Environment=GIT_CONFIG_GLOBAL=/etc/montara-pilot/gitconfig
Environment=GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=0 GIT_OPTIONAL_LOCKS=0
UnsetEnvironment=GIT_CONFIG_PARAMETERS
ExecStart=/opt/montara-pilot/current/pilot-runtime/venv/bin/python -I -m montara_core --config /etc/montara-pilot/core.toml --worker-once
Restart=no
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=10s
RuntimeMaxSec=600s
MemoryMax=4G
CPUQuota=200%
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/montara-pilot
InaccessiblePaths=/etc/montara-pilot/client-secret
UMask=0077
